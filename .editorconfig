root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Web / config / docs — 2 espaços
[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,md,html,css,scss,svg}]
indent_size = 2

# C# — 4 espaços (padrão .NET)
[*.cs]
indent_size = 4

# Dart / Flutter — 2 espaços (padrão Dart)
[*.dart]
indent_size = 2

# Makefile — tabs obrigatórios
[Makefile]
indent_style = tab
