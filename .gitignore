# =====================================================
# Haishabet — .gitignore
# =====================================================

# ---- .NET / Visual Studio / Rider ----
bin/
obj/
*.user
*.suo
.vs/
*.userprefs
**/Properties/launchSettings.json
[Dd]ebug/
[Rr]elease/
*.swp

# ---- Node / Next.js / pnpm ----
node_modules/
.next/
out/
dist/
.pnpm-store/
*.tsbuildinfo
.turbo/
.vercel/

# ---- Flutter / Dart ----
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
android/.gradle/
android/captures/
android/local.properties
android/key.properties
android/app/release/
android/app/debug/
*.iml
.metadata

# ---- IDEs ----
.idea/
.vscode/

# ---- OS ----
.DS_Store
Thumbs.db
*~

# ---- Env / secrets (NUNCA comitar) ----
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Production.json
!appsettings.json
!appsettings.Example.json
secrets.json
*.pfx
*.pem
*.key

# ---- Logs / DBs locais ----
*.log
logs/
*.sqlite
*.sqlite3
*.db

# ---- Docker volumes locais (se algum dia ficarem em path do repo) ----
data/
volumes/

# ---- Coverage / testes ----
coverage/
*.coverage
*.coveragexml
TestResults/
.nyc_output/
